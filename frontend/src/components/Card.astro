---
import { urlFor } from "../utils/image";
import type { Project } from "../utils/sanity";
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Get the proper localized URL for the project
const projectUrl = getRelativeLocaleUrl(Astro.currentLocale || 'en', `/project/${project.slug.current}`);

---

<div class="flex flex-col p-2 relative border-b border-gray-200 md:border md:border-b-0 md:last:border-b md:rounded-t-md md:last:rounded-b-md md:flex-row">
  {project.heroImage ? (
    <img
      class="w-full h-[231px] object-cover md:min-w-[366.5px] md:max-w-[366.5px] md:max-h-[231px]"
      src={urlFor(project.heroImage).width(500).height(300).url()}
      alt={project.heroImage.alt || ""}
    />
  ) : (
    <div class="w-full h-[231px] bg-black md:min-w-[366.5px] md:max-w-[366.5px] md:max-h-[231px]" />
  )}
  <div class="m-0 md:mx-5 w-full">
    <h3 class="font-sans font-extrabold text-2xl leading-9 tracking-tight my-3 md:mt-5">
      <a
        class="text-black no-underline hover:opacity-80 transition duration-200 relative"
        href={projectUrl}
      >
        {project.title}
      </a>
    </h3>
    <p class="text-sm text-gray-500 mb-2">{project.projectType}</p>
    <p class="font-serif font-normal text-lg leading-7 mt-0">
      {typeof project.description === 'object' && project.description !== null ? (project.description as any)?.en : project.description}
    </p>
    {project.technologies && project.technologies.length > 0 && (
      <div class="mt-2 flex flex-wrap gap-2">
        {project.technologies.map((tech) => (
          <span class="px-2 py-1 bg-gray-100 text-xs rounded">
            {typeof tech === 'string' ? tech : tech}
          </span>
        ))}
      </div>
    )}
  </div>
</div>


