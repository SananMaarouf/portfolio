---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404 - Page not found">
  <div style="text-align: center; margin-top: 50px;">
    <img 
      src="/confused_travolta.gif" 
      width="300" 
      height="300" 
      alt="404 gif"
      class="mx-auto"
      loading="lazy"
    />
    <h1 class="mt-6 text-xl">404 - Page not found</h1>
    <a 
      href="/" 
      class="mt-6 inline-block bg-white hover:bg-deco text-black hover:text-white hover:scale-150 transition-all 
      duration-300 ease-in-out no-underline rounded-full px-6 py-2"
    >
      Go back home
    </a>
  </div>
</Layout>

