---
import type { InferGetStaticParamsType } from "astro";
import type { ProjectWithGallery } from "../../../lib/types";
import Layout from "../../../layouts/Layout.astro";
import { formatDate } from "../../../utils";
import { urlFor } from "../../../utils/image";
import { getProject, getProjects } from "../../../utils/sanity";
import ExperienceAccordion from "@/components/experienceAccordion";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.slug.current },
  }));
}

type Params = InferGetStaticParamsType<typeof getStaticPaths>;
const { slug } = Astro.params as Params;

const project: ProjectWithGallery = await getProject(slug);

---

<Layout title={project.title!}>
  <section class="mx-auto w-full lg:w-1/2 my-1 mb-5">
    {
      project.heroImage ? (
        <img
          class="w-full h-[350px] object-contain md:w-[750px] md:h-[420px]"
          src={urlFor(project.heroImage).url()}
          alt="Cover image"
        />
      ) : (
        <div class="w-full h-[350px] bg-black md:w-[750px] md:h-[420px]" />
      )
    }
    <div class="px-3">
      <h1 class="font-sans text-4xl md:text-6xl font-extrabold leading-9 md:leading-[72px] mt-12 md:mt-0 mb-0 tracking-tight" >
        {project.title}
      </h1>
      <p class="font-serif text-2xl md:text-2xl font-normal leading-7 md:leading-8 my-4" >
        {
          typeof project.description === "object" &&
          project.description !== null
            ? (project.description as any)?.nb
            : project.description
        }
      </p>
      <p class="font-sans font-semibold text-sm md:text-lg leading-5 md:leading-6 my-4" >
        {formatDate(project.date)}
      </p>

      {/* Image Carousel for gallery */}
      {
        project.gallery &&
          Array.isArray(project.gallery) &&
          project.gallery.length > 0 && (
            <div class="w-full my-8">
              <div class="flex overflow-x-scroll gap-4 scrollbar-hide py-2">
                {project.gallery.map((img, idx) => (
                  <div class="min-w-[300px] max-w-[350px] h-[550px] flex flex-col items-center justify-center bg-black rounded-lg">
                    <img
                      src={urlFor(img.asset).url()}
                      alt={img.alt || img.title || "Project image"}
                      class="object-cover w-full h-[480px] rounded-t-lg"
                    />
                    <div class="text-xs text-center text-white py-1 px-2 w-full truncate">
                      {img.title || img.alt}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )
      }

      <div class="font-serif font-normal text-xl leading-8 tracking-tight mt-13 md:mt-21" >
        {project.body?.nb}
      </div>

      {/* Experience Accordion */}
      {
        project.Experience &&
          Array.isArray(project.Experience) &&
          project.Experience.length > 0 && (
            <ExperienceAccordion
              client:load
              experiences={project.Experience}
              title="Erfaringer"
              versionLabels={["V1", "V2", "V3"]}
            />
          )
      }
      {/* Technologies */}
      {project.technologies && project.technologies.length > 0 && (
        <section class="my-5 md:my-12">
          <h3 class="text-2xl font-bold mb-4 underline">Teknologier</h3>
          <div class="flex flex-wrap gap-2">
            {project.technologies.map((tech: string, index: number) => (
              <span class="px-3 py-1 bg-deco font-silkscreen text-white rounded-full text-sm">
                {tech}
              </span>
            ))}
          </div>
        </section>
      )}

      {/* Links */}
      {(project.githubUrl || project.liveUrl) && (
        <section class="my-10 font-silkscreen md:my-12">
          <div class="flex gap-4">
            {project.githubUrl && (
              <a href={project.githubUrl} target="_blank" rel="noopener noreferrer"
                class="group px-4 py-2  bg-deco flex flex-row items-center align-center gap-2 text-white rounded hover:bg-white hover:text-deco transition-colors duration-200"
              >
                Se på GitHub
                <span class="text-sm">
                  <svg
                    width="32"
                    height="32"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="w-8 h-8 text-white group-hover:text-deco transition-colors duration-200"
                  >
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.30.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                </span>
              </a>
            )}
            {project.liveUrl && (
              <a
                href={project.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-3 bg-deco text-white rounded hover:opacity-90 transition-opacity"
              >
                Se nettside
              </a>
            )}
          </div>
        </section>
      )}

      

      {/* Back to projects */}
      <section class="my-5 md:my-10">
        <a
          href="/nb#projects"
          class="text-xl text-deco font-silkscreen hover:underline"
        >
          ← Tilbake
        </a>
      </section>

    </div>
  </section>
</Layout>
