---
import { createImageUrlBuilder, type SanityImageSource } from '@sanity/image-url'
import {sanityClient} from 'sanity:client'

const builder = createImageUrlBuilder(sanityClient)

const { node, width = 960, alt = '', class: className = '' } = Astro.props

// See https://www.sanity.io/docs/presenting-images for general documentation on
// presenting images, and https://www.sanity.io/docs/image-url for specifics on
// this builder API
const image = node && builder.image(node as SanityImageSource).width(width)
---

{image && (
	<img
		src={image.url()}
		alt={alt || node.alt || ''}
		title={node.alt}
		class={className}
	/>
)}