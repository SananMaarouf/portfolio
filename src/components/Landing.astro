---
import { getLanding } from '@/utils/sanity';
import sananSvg from '../assets/sanan.svg?url';

interface Props {
	lang?: string;
}

const { lang = 'en' } = Astro.props;

const landingData = await getLanding(lang);
const { name, job, location } = landingData ?? {};
---

<section class="relative isolate">
	{!landingData ? (
		<section class="mt-10 mb-28 min-h-[60vh] py-24 w-11/12 mx-auto bg-transparent flex items-center justify-center">
			<p>Loading...</p>
		</section>
	) : (
		<section class="lg:mt-20 mb-28 py-12 lg:py-24 relative w-11/12 mx-auto 
		bg-transparent flex flex-col md:block gap-6 min-h-[60vh] md:h-[60vh] text-center md:text-left">
			<div class="relative z-10 order-1 mix-blend-difference">
				<h1 class="text-6xl md:text-8xl font-bold tracking-tight">
					<span class="break-keep">
						{name?.split(' ').map((part) => (
							<span class="block">{part}</span>
						))}
					</span>
				</h1>
			</div>
			<img
				src={sananSvg}
				alt="Sanan"
				class="order-2 relative md:absolute md:right-0 md:top-1/2 md:-translate-y-1/2 h-72 md:h-[100%] w-auto object-contain mx-auto md:mx-0"
			/>
			<div class="relative z-10 order-3 mix-blend-difference md:mt-6">
				<p class="text-2xl md:text-4xl">{job}</p>
				<p class="mt-2 text-xl md:text-2xl">{location}</p>
			</div>
		</section>
	)}
</section>
