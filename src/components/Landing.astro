---
import { getLanding } from '@/utils/sanity';
import sananSvg from '../assets/sanan.svg?url';

interface Props {
	lang?: string;
}

const { lang = 'en' } = Astro.props;

const landingData = await getLanding(lang);
const { name, job, location } = landingData ?? {};
const firstName = name?.split(' ')[0] ?? '';
const lastName = name?.split(' ')[1] ?? '';
---

<section class="relative isolate overflow-hidden md:overflow-visible">
	{!landingData ? (
		<section class="mt-10 mb-28 min-h-[60vh] py-24 w-11/12 mx-auto bg-transparent flex items-center justify-center">
			<p>Loading...</p>
		</section>
	) : (
		<section class="mt-2 lg:mt-20 mb-28 py-12 lg:py-24 relative w-11/12 mx-auto
		bg-transparent min-h-[60vh] md:h-[60vh]">
			<div class="absolute top-20 md:top-0 left-0 z-10 text-left mix-blend-difference">
				<h1 class="text-6xl md:text-8xl font-bold tracking-tight">
					<div class="md:hidden block">
						<span class="block break-keep">Hi,</span>
						<span class="block break-keep">i'm</span>
					</div>
					<div class="md:block hidden">
						<span class="block break-keep">Hi, i'm</span>
					</div>
					<span class="block break-keep mix-blend-difference">{firstName}</span>
					<span class="block break-keep mix-blend-difference">{lastName}</span>
				</h1>
			</div>
			<div class="absolute bottom-15 md:bottom-5 left-0 z-10 mix-blend-difference">
				<p class="text-2xl md:text-4xl">{job}</p>
				<p class="mt-2 text-xl md:text-2xl">{location}</p>
			</div>
		</section>
	)}
	{landingData && (
		<img
			src={sananSvg}
			alt="Sanan"
			class="
			absolute top-1/2 right-0 -translate-y-1/2 
			translate-x-1/3
			md:inset-0 md:m-auto md:translate-x-1/2 md:translate-y-0 h-screen 
			md:h-[calc(100vh-10rem)] 
			object-contain pointer-events-none 
			"
		/>
	)}
</section>
