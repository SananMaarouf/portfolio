---
import Introduction from './react/introduction';
import LandingThree from './react/landing-three';
import { getLanding } from '@/utils/sanity';

interface Props {
	lang?: string;
}

const { lang = 'en' } = Astro.props;

// Fetch landing page data from Sanity
const landingData = await getLanding(lang);
---

<section class="relative isolate overflow-hidden">
	<LandingThree client:load />
	<div class="landing-gated">
		<Introduction client:load landingData={landingData} />
	</div>
</section>
