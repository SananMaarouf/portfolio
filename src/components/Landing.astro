---
import { getLanding } from '@/utils/sanity';
import SananArt from './SananArt.astro';

interface Props {
	lang?: string;
}

const { lang = 'en' } = Astro.props;

const landingData = await getLanding(lang);
const { name, job, location } = landingData ?? {};
const firstName = name?.split(' ')[0] ?? '';
const lastName = name?.split(' ')[1] ?? '';
---

<section class="relative isolate overflow-hidden md:overflow-visible">
	{!landingData ? (
		<section class="mt-10 mb-28 min-h-[60vh] py-24 w-11/12 mx-auto bg-transparent flex items-center justify-center">
			<p>Loading...</p>
		</section>
	) : (
		<section class="z-10 mb-28 lg:mt-10 lg:py-2 relative w-full md:w-11/12 mx-auto
		bg-transparent min-h-[40vh] md:h-[60vh] text-foreground
		flex flex-col justify-center md:justify-end ">
			<div class="text-left">
				<h1 class="font-display text-6xl md:text-9xl font-bold tracking-tight">
					<span class="block break-keep">{firstName}</span>
					<span class="block break-keep">{lastName}</span>
				</h1>
			</div>
			<div class="">
				<p class="text-2xl md:text-4xl">{job}</p>
				<p class="mt-2 text-xl md:text-2xl">{location}</p>
			</div>
		</section>
	)}
	{landingData && (
		<SananArt
			class="
			absolute bottom-0 right-0 translate-x-[15%] h-[45vh] max-h-80
			md:inset-0 md:m-auto md:translate-x-2/3 md:translate-y-0
			md:h-[calc((100vh-10rem)*0.75)] md:max-h-none object-contain pointer-events-none -z-10
			"
		/>
	)}
</section>
