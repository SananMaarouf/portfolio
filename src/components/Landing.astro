---
import { getLanding } from '@/utils/sanity';
import sananSvg from '../assets/sanan.svg?url';

interface Props {
	lang?: string;
}

const { lang = 'en' } = Astro.props;

const landingData = await getLanding(lang);
const { name, job, location } = landingData ?? {};
const firstName = name?.split(' ')[0] ?? '';
const lastName = name?.split(' ')[1] ?? '';
---

<section class="relative isolate overflow-hidden md:overflow-visible">
	{!landingData ? (
		<section class="mt-10 mb-28 min-h-[60vh] py-24 w-11/12 mx-auto bg-transparent flex items-center justify-center">
			<p>Loading...</p>
		</section>
	) : (
		<section class="z-10 lg:mt-20 mb-28 lg:py-2 relative w-11/12 mx-auto
		bg-transparent min-h-[60vh] md:h-[60vh] mix-blend-difference 
		flex flex-col justify-end ">
			<div class="text-left mix-blend-difference">
				<h1 class="text-5xl md:text-9xl font-bold tracking-tight">
					<span class="block break-keep">{firstName}</span>
					<span class="block break-keep">{lastName}</span>
				</h1>
			</div>
			<div class="">
				<p class="text-2xl md:text-4xl">{job}</p>
				<p class="mt-2 text-xl md:text-2xl">{location}</p>
			</div>
		</section>
	)}
	{landingData && (
		<img
			src={sananSvg}
			alt="Sanan"
			class="
			absolute top-1/2 right-0 -translate-y-1/2 translate-x-1/3
			md:inset-0 md:m-auto md:translate-x-1/2 md:translate-y-0 h-screen 
			md:h-[calc(100vh-10rem)] object-contain pointer-events-none 
			"
		/>
	)}
</section>
