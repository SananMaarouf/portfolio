---
import Layout from "../../layouts/Layout.astro";
import { getPosts } from "@/utils/sanity";
import SanityImage from "@/components/SanityImage.astro";

const lang = "en";
const posts = await getPosts(lang);

const t = {
	title: "Posts",
	no_posts: "No posts available",
};

const getPostUrl = (slug: string) => `/post/${slug}`;

const dateLocale = "en-US";

const formatDate = (dateString: string) => {
	const date = new Date(dateString);
	return date.toLocaleDateString(dateLocale, {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
};
---

<Layout lang={lang}>
	<section
		id="projects"
		class="my-10 text-foreground md:mx-auto relative w-full bg-transparent scroll-mt-24"
	>
		<h1 class="text-3xl mb-6">{t.title}</h1>
		{
			posts && posts.length > 0 ? (
				<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{posts.map((post, index) => (
							<article
							class="
							group shrink-0 h-fit overflow-hidden 
							bg-primary text-primary-foreground rounded-xl
							hover:bg-secondary hover:text-secondary-foreground
							transition-all duration-300 ease-linear flex flex-col
							"
						>
							<a href={getPostUrl(post.slug.current)} class="w-full h-full flex flex-col relative">
								<section class="p-4 grow flex flex-col gap-2">
									<div class="flex justify-between">
										<p class="text-2xl">0{index + 1}</p>
										<time
											datetime={post.publishedAt ?? post._createdAt}
											class="text-sm my-auto"
										>
											{formatDate(post.publishedAt ?? post._createdAt)}
										</time>
									</div>
									{post.mainImage && (
										<figure>
											<SanityImage
												node={post.mainImage}
												width={600}
												alt={post.mainImage.alt || post.title}
												class="h-44 w-full object-cover rounded-lg"
											/>
										</figure>
									)}
									<h2 class="text-2xl whitespace-normal wrap-break-word">
									{post.title ?? post.slug.current}
									</h2>
									<p class="text-sm mt-2 line-clamp-2">{post.excerpt ?? ""}</p>
								</section>
							</a>
							</article>
					))}
				</div>
			) : (
				<p class="text-lg">{t.no_posts}</p>
			)
		}
	</section>
</Layout>