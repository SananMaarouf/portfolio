---
import Layout from "../../layouts/Layout.astro";
import { sanityClient } from "sanity:client";
import groq from "groq";
import PortableText from "@/components/PortableText.astro";
import SanityImage from "@/components/SanityImage.astro";
import type { Project } from "../../../types/project";
import { Button } from "@/components/ui/button";
import { ExternalLink } from "lucide-react";

export async function getStaticPaths() {
	const projects = await sanityClient.fetch(
		groq`*[_type == "project" && defined(slug.current)]{
			"slug": slug.current
		}`,
	);

	return projects.map((project: { slug: string }) => ({
		params: { slug: project.slug },
	}));
}

const { slug } = Astro.params;
const lang = "en";

const project = await sanityClient.fetch<Project>(
	groq`*[_type == "project" && slug.current == $slug][0]{
		_id,
		_createdAt,
		title,
		slug,
		"description": description[language == $lang][0].value,
		date,
		version,
		heroImage,
		gallery,
		technologies,
		projectType,
		"body": body[language == $lang][0].value,
		githubUrl,
		liveUrl
	}`,
	{ slug, lang },
);

if (!project) {
	return Astro.redirect("/404");
}
---

<Layout lang={lang}>
	<article class="w-full max-w-2xl mx-auto py-8">
		<header class="mb-2">
			<section class="flex justify-between items-center">
				<h1 class="text-4xl font-bold">{project.title}</h1>
				<span
					class="rotate-40 md:rotate-20 lg:rotate-0 transition-all duration-700 text-lg lg:text-2xl"
				>
					{project.version}
				</span>
			</section>

			{
				project.description && (
					<section class="text-lg" aria-label="Project description">
						<p>{project.description}</p>
					</section>
				)
			}
		</header>

		{
			project.heroImage && (
				<figure class="m-0">
					<SanityImage node={project.heroImage} alt={project.title} />
				</figure>
			)
		}

		{
			project.date && (
				<section class="flex gap-2 mb-4" aria-label="Publication date">
					<p>Published:</p>
					<time class="" datetime={project.date}>
						{new Date(project.date).toLocaleDateString("en-US", {
							year: "numeric",
							month: "long",
							day: "numeric",
						})}
					</time>
				</section>
			)
		}

		{
			project.body && (
				<section class="prose text-foreground dark:prose-invert mb-8" aria-label="Project content">
					<PortableText value={project.body} />
				</section>
			)
		}

		{
			project.gallery && project.gallery.length > 0 && (
				<section class="mb-8" aria-labelledby="gallery-heading">
					<h2 id="gallery-heading" class="text-2xl font-bold mb-4">Gallery</h2>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						{project.gallery.map((image) => (
							<figure class="m-0">
								<SanityImage
									node={image}
									alt={image.alt || image.title || project.title}
								/>
								{image.title && (
									<figcaption class="text-sm text-gray-600 dark:text-gray-400 mt-2">
										{image.title}
									</figcaption>
								)}
							</figure>
						))}
					</div>
				</section>
			)
		}

		{
			project.technologies && project.technologies.length > 0 && (
				<section class="mb-8" aria-labelledby="technologies-heading">
					<h2 id="technologies-heading" class="mb-2 underline">Technologies:</h2>
					<ul class="flex flex-wrap gap-2 list-none p-0 m-0">
						{project.technologies.map((tech) => (
							<li>
								<span class="bg-primary text-primary-foreground px-3 py-1 rounded-md text-sm">
									{tech}
								</span>
							</li>
						))}
					</ul>
				</section>
			)
		}

		<section class="flex flex-col gap-2 mt-8" aria-labelledby="project-links-heading">
			<h2 id="project-links-heading" class="underline text-base font-normal m-0">
				Links:
			</h2>

			<nav aria-label="Project links">
				<ul class="flex gap-4 list-none p-0 m-0">
					{
						project.githubUrl && (
							<li>
								<Button className="hover:scale-105">
									<a
										href={project.githubUrl}
										target="_blank"
										rel="noopener noreferrer"
									>
										GitHub
										<ExternalLink className="inline-block ml-2" />
									</a>
								</Button>
							</li>
						)
					}
					{
						project.liveUrl && (
							<li>
								<Button className="hover:scale-105">
									<a
										href={project.liveUrl}
										target="_blank"
										rel="noopener noreferrer"
									>
										Website
										<ExternalLink className="inline-block ml-2" />
									</a>
								</Button>
							</li>
						)
					}
				</ul>
			</nav>
		</section>
	</article>
</Layout>
