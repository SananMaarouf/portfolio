---
import '../styles/global.css';
import { Navbar } from '@/components/react/navbar';
import { ClientRouter } from 'astro:transitions';
import { THEMES, DEFAULT_THEME, THEME_STORAGE_KEY } from '@/lib/theme';

interface Props {
	lang?: string;
}

const { lang = 'en' } = Astro.props;
const locale = lang as 'en' | 'nb';

const pageTitle = import.meta.env.PUBLIC_PAGE_TITLE;
const navbarTitle = import.meta.env.PUBLIC_NAVBAR_TITLE;

// Menu translations
const menuTranslations = {
	en: [
		{ title: "Projects", url: "/projects" },
		{ title: "Posts", url: "/posts" },
	],
	nb: [
		{ title: "Prosjekter", url: "/projects" },
		{ title: "Innlegg", url: "/posts" },
	]
};

const menu = menuTranslations[locale];
---
<!doctype html>

<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="preload" as="image" href="/sanan1.webp" fetchpriority="high" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Young+Serif&display=swap"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<ClientRouter />
		{/*
		  Pre-paint theme application. Must stay is:inline (define:vars implies it)
		  so it runs synchronously before first paint — this is the only thing
		  preventing a flash of the wrong theme.
		*/}
		<script is:inline define:vars={{ THEMES, DEFAULT_THEME, THEME_STORAGE_KEY }}>
			(function () {
				// define:vars emits top-level consts; a re-exec would be a SyntaxError.
				if (window.__themeInit) return;
				window.__themeInit = true;

				function resolveTheme() {
					var stored = null;
					try {
						stored = localStorage.getItem(THEME_STORAGE_KEY);
					} catch (e) {
						// Safari private mode throws on access
					}
					if (THEMES.indexOf(stored) !== -1) return stored;
					// Never persisted: an undecided visitor keeps tracking their OS.
					try {
						return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
					} catch (e) {
						return DEFAULT_THEME;
					}
				}

				function applyTheme(root) {
					root.setAttribute('data-theme', resolveTheme());
				}

				applyTheme(document.documentElement);

				// ClientRouter copies <html> attributes from the incoming document,
				// so stamp the new document before the swap (no themeless frame) …
				document.addEventListener('astro:before-swap', function (event) {
					applyTheme(event.newDocument.documentElement);
				});
				// … and re-assert afterwards as a fallback.
				document.addEventListener('astro:after-swap', function () {
					applyTheme(document.documentElement);
				});
			})();
		</script>
	</head>
	<body class="bg-background text-foreground transition-colors duration-300 ease-linear">
		<Navbar client:load transition:persist logo={{ title: navbarTitle, image: "/sanan1.webp" }} locale={locale} menu={menu} />
		<div class="max-w-6xl pt-20 mx-auto px-4 sm:px-6 md:px-8 lg:px-10">
			<slot />
		</div>
	</body>
</html>
